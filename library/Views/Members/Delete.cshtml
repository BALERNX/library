```cshtml
@model library.Models.Member

@{
    ViewData["Title"] = "Delete Member";
}

<h1>Delete Member</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this member?
</div>

<dl class="row">
    <dt class="col-sm-3">Member ID</dt>
    <dd class="col-sm-9">@Model.MemberId</dd>

    <dt class="col-sm-3">Full Name</dt>
    <dd class="col-sm-9">@Model.FullName</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@(Model.Email ?? "—")</dd>

    <dt class="col-sm-3">Member Type</dt>
    <dd class="col-sm-9">@Model.MemberType</dd>
</dl>

<form asp-action="Delete"
      asp-route-id="@Model.MemberId"
      method="post">

    <button type="submit" class="btn btn-danger">
        Confirm Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>
```