@model library.Models.Member

@{
    ViewData["Title"] = "Delete Member";
}

<div class="delete-member-page">

    <style>
            .delete-member-page {
                --navy: #102a43;
                --teal: #176b70;
                --red: #c0392b;
                color: #243b53;
                padding: 35px 0;
            }

            .delete-card {
                max-width: 650px;
                margin: 0 auto;
                background: white;
                border: 1px solid #e6edf2;
                border-radius: 18px;
                overflow: hidden;
                box-shadow: 0 8px 25px rgba(16, 42, 67, .08);
            }

            .delete-header {
                background: var(--navy);
                color: white;
                padding: 28px;
            }

            .warning-icon {
                width: 55px;
                height: 55px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 16px;
                background: #fff0ed;
                color: var(--red);
                font-size: 1.7rem;
                margin-bottom: 16px;
            }

            .delete-body {
                padding: 28px;
            }

            .warning-message {
                background: #fff6e5;
                border: 1px solid #f4d58d;
                border-radius: 12px;
                padding: 16px;
                color: #805b13;
                margin-bottom: 25px;
            }

            .member-info {
                background: #f5f8fa;
                border-radius: 12px;
                padding: 20px;
                margin-bottom: 25px;
            }

            .info-label {
                color: #627d98;
                font-size: .78rem;
                font-weight: 700;
                text-transform: uppercase;
                margin-bottom: 5px;
            }

            .info-value {
                color: var(--navy);
                font-weight: 600;
                overflow-wrap: anywhere;
            }

            .btn-delete {
                background: var(--red);
                color: white;
                border: none;
                border-radius: 9px;
                padding: 11px 20px;
                font-weight: 600;
            }

                .btn-delete:hover {
                    background: #a93226;
                    color: white;
                }

            .btn-cancel {
                background: white;
                color: var(--navy);
                border: 1px solid #cbd5df;
                border-radius: 9px;
                padding: 11px 20px;
                font-weight: 600;
                text-decoration: none;
            }

                .btn-cancel:hover {
                    background: #edf2f6;
                    color: var(--navy);
                }
    </style>

    <div class="container">

        <div class="delete-card">

            <!-- Header -->
            <div class="delete-header">
                <div class="warning-icon">⚠</div>

                <h1 class="h3 fw-bold mb-2">
                    Delete Member
                </h1>

                <p class="mb-0 text-white-50">
                    Member Management / Delete Confirmation
                </p>
            </div>

            <!-- Body -->
            <div class="delete-body">

                <div class="warning-message">
                    <strong>Are you sure you want to delete this member?</strong>
                    <div class="small mt-1">
                        This action cannot be undone. Please review the member
                        information before continuing.
                    </div>
                </div>

                <h5 class="fw-bold mb-3">
                    Member Information
                </h5>

                <div class="member-info">

                    <div class="row g-3">

                        <div class="col-sm-6">
                            <div class="info-label">Member ID</div>
                            <div class="info-value">
                                @Model.MemberId
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="info-label">Member Type</div>
                            <div class="info-value">
                                @Model.MemberType
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="info-label">Full Name</div>
                            <div class="info-value">
                                @Model.FullName
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="info-label">Email Address</div>
                            <div class="info-value">
                                @(Model.Email ?? "No email provided")
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Actions -->
                <form asp-action="Delete"
                      asp-route-id="@Model.MemberId"
                      method="post">

                    <div class="d-flex flex-wrap gap-2">

                        <button type="submit" class="btn-delete">
                            Delete Member
                        </button>

                        <a asp-action="Index" class="btn-cancel">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>
