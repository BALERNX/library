@model List<library.Models.LoanView>

@{
    ViewData["Title"] = "Loans";

    var totalLoans = Model.Count;
    var booksOut = Model.Count(loan => loan.Status == "Out");
    var overdueLoans = Model.Count(loan => loan.Status == "Overdue");
}

<style>
    .loans-page {
        max-width: 1200px;
        margin: 35px auto;
        padding: 0 20px;
        color: #172b4d;
    }

    .loans-hero {
        background: linear-gradient(120deg, #102a43, #176b70);
        color: white;
        padding: 35px;
        border-radius: 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
        box-shadow: 0 12px 30px rgba(16, 42, 67, .15);
    }

        .loans-hero h1 {
            font-size: 2.4rem;
            font-weight: 800;
            margin: 0;
        }

        .loans-hero p {
            color: #d6e8ed;
            margin: 8px 0 0;
        }

    .hero-icon {
        font-size: 50px;
        margin-right: 18px;
    }

    .add-loan-btn {
        background: #f4c95d;
        color: #172b4d;
        border-radius: 10px;
        padding: 13px 20px;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
        transition: .2s;
    }

        .add-loan-btn:hover {
            background: #ffda79;
            color: #172b4d;
            transform: translateY(-2px);
        }

    .loan-summary {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 25px;
    }

    .summary-card {
        background: white;
        border: 1px solid #e5edf2;
        border-radius: 15px;
        padding: 22px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: 0 5px 18px rgba(16, 42, 67, .04);
    }

    .summary-icon {
        width: 52px;
        height: 52px;
        display: grid;
        place-items: center;
        border-radius: 13px;
        background: #e3f4f1;
        font-size: 24px;
    }

    .summary-number {
        font-size: 25px;
        font-weight: 800;
        color: #176b70;
    }

    .summary-label {
        color: #718096;
        font-size: 12px;
    }

    .overdue-number {
        color: #c43d4b;
    }

    .loans-card {
        background: white;
        border: 1px solid #e5edf2;
        border-radius: 16px;
        padding: 22px;
        box-shadow: 0 8px 25px rgba(16, 42, 67, .05);
    }

        .loans-card h2 {
            font-size: 19px;
            font-weight: 750;
            margin-bottom: 5px;
        }

    .loans-subtitle {
        color: #8291a5;
        font-size: 13px;
        margin-bottom: 20px;
    }

    .loans-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

        .loans-table thead th {
            background: #edf4f5;
            color: #385568;
            padding: 15px 14px;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .7px;
            border: none;
            white-space: nowrap;
        }

            .loans-table thead th:first-child {
                border-radius: 9px 0 0 9px;
            }

            .loans-table thead th:last-child {
                border-radius: 0 9px 9px 0;
            }

        .loans-table tbody td {
            padding: 17px 14px;
            border-bottom: 1px solid #edf1f5;
            vertical-align: middle;
            font-size: 14px;
        }

        .loans-table tbody tr:hover {
            background: #f7fbfb;
        }

    .loan-member {
        font-weight: 700;
        color: #183b56;
    }

    .loan-book {
        color: #52677d;
    }

    .loan-date {
        color: #718096;
        white-space: nowrap;
    }

    .status-badge {
        display: inline-block;
        padding: 7px 13px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-out {
        background: #fff4d6;
        color: #946200;
    }

    .status-overdue {
        background: #fff0f0;
        color: #c43d4b;
    }

    .status-returned {
        background: #e1f3ef;
        color: #167568;
    }

    .return-btn {
        background: #e7f5f3;
        color: #176b70;
        border: 1px solid #b9e0db;
        border-radius: 8px;
        padding: 8px 13px;
        font-size: 12px;
        font-weight: 700;
        transition: .2s;
    }

        .return-btn:hover {
            background: #176b70;
            color: white;
        }

    .completed-label {
        color: #8291a5;
        font-size: 12px;
        font-weight: 600;
    }

    .empty-loans {
        text-align: center;
        padding: 55px 15px;
        color: #8291a5;
    }

    .empty-icon {
        font-size: 45px;
        margin-bottom: 12px;
    }

    .loans-footer {
        color: #8291a5;
        font-size: 12px;
        padding-top: 18px;
        margin-top: 18px;
        border-top: 1px solid #edf1f5;
    }

    @@media (max-width: 800px) {
        .loan-summary {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 700px) {
        .loans-hero {
            flex-direction: column;
            align-items: flex-start;
            padding: 25px;
        }

            .loans-hero h1 {
                font-size: 2rem;
            }

        .loans-table {
            min-width: 800px;
        }

        .loans-card {
            padding: 14px;
        }
    }
</style>

<div class="loans-page">

    <!-- HEADER -->
    <div class="loans-hero">
        <div class="d-flex align-items-center">
            <div class="hero-icon">📚</div>
            <div>
                <h1>Loan Management</h1>
                <p>Monitor borrowed books, due dates, and returns.</p>
            </div>
        </div>

        <a asp-action="Borrow" class="add-loan-btn">
            + Borrow a Book
        </a>
    </div>

    <!-- SUMMARY CARDS -->
    <div class="loan-summary">

        <div class="summary-card">
            <div class="summary-icon">📋</div>
            <div>
                <div class="summary-number">@totalLoans</div>
                <div class="summary-label">TOTAL LOAN RECORDS</div>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon">📖</div>
            <div>
                <div class="summary-number">@booksOut</div>
                <div class="summary-label">BOOKS CURRENTLY OUT</div>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon">⚠️</div>
            <div>
                <div class="summary-number overdue-number">@overdueLoans</div>
                <div class="summary-label">OVERDUE LOANS</div>
            </div>
        </div>

    </div>

    <!-- LOAN RECORDS -->
    <div class="loans-card">

        <h2>Borrowing Records</h2>
        <p class="loans-subtitle">
            All transactions, arranged from newest to oldest
        </p>

        @if (Model.Count == 0)
        {
            <div class="empty-loans">
                <div class="empty-icon">📚</div>
                <h4>No Loans Found</h4>
                <p>There are currently no borrowed books.</p>

                <a asp-action="Borrow" class="add-loan-btn d-inline-block">
                    Borrow Your First Book
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="loans-table">

                    <thead>
                        <tr>
                            <th>Member</th>
                            <th>Book</th>
                            <th>Loaned</th>
                            <th>Due Date</th>
                            <th>Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var loan in Model)
                        {
                            <tr>
                                <td class="loan-member">
                                    @loan.MemberName
                                </td>

                                <td class="loan-book">
                                    @loan.BookTitle
                                </td>

                                <td class="loan-date">
                                    @loan.LoanedOn.ToString("yyyy-MM-dd")
                                </td>

                                <td class="loan-date">
                                    @loan.LoanedOn.AddDays(loan.DaysAllowed).ToString("yyyy-MM-dd")
                                </td>

                                <td>
                                    @if (loan.Status == "Overdue")
                                    {
                                        <span class="status-badge status-overdue">
                                            ● Overdue
                                        </span>
                                    }
                                    else if (loan.Status == "Out")
                                    {
                                        <span class="status-badge status-out">
                                            ● Out
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-returned">
                                            ● Returned
                                        </span>
                                    }
                                </td>

                                <td class="text-center">
                                    @if (loan.ReturnedOn == null)
                                    {
                                        <form asp-action="Return"
                                              asp-route-id="@loan.LoanId"
                                              method="post"
                                              class="d-inline">

                                            <button type="submit" class="return-btn">
                                                ✓ Return
                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <span class="completed-label">
                                            Completed
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

        <div class="loans-footer">
            Showing @Model.Count loan record(s).
        </div>

    </div>

</div>
