@model library.Models.Note

@{
    ViewData["Title"] = "Delete Note";
}

<div class="container mt-4">
    <h1>Delete Note</h1>
    <p>Are you sure you want to delete this note?</p>

    <dl class="row">
        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@Model.Title</dd>

        <dt class="col-sm-3">Body</dt>
        <dd class="col-sm-9">@(Model.Body ?? "No body")</dd>

        <dt class="col-sm-3">Created On</dt>
        <dd class="col-sm-9">@Model.CreatedOn.ToString("yyyy-MM-dd")</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.NoteId" method="post">
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
