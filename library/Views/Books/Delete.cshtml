@model library.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<h1>Delete Book</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this book?
</div>

<dl class="row">
    <dt class="col-sm-3">Book ID</dt>
    <dd class="col-sm-9">@Model.BookId</dd>

    <dt class="col-sm-3">Title</dt>
    <dd class="col-sm-9">@Model.Title</dd>

    <dt class="col-sm-3">Category</dt>
    <dd class="col-sm-9">@(Model.Category ?? "—")</dd>

    <dt class="col-sm-3">Price</dt>
    <dd class="col-sm-9">@(Model.Price?.ToString("N2") ?? "—")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.BookId" method="post">
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
